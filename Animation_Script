--========================================================--
-- ANIMATION FUNCTIONS
--========================================================--

local CurrentPack = nil
local Buttons = {}

local function setAnimation(obj,id)
    if obj and id then
        pcall(function()
            obj.AnimationId = "rbxassetid://" .. tostring(id)
        end)
    end
end

local function findAnimation(folder,...)
    if not folder then
        return nil
    end

    for i = 1,select("#",...) do
        local Name = select(i,...)
        local Obj = folder:FindFirstChild(Name)

        if Obj and Obj:IsA("Animation") then
            return Obj
        end
    end

    return nil
end

local function makeAnimation(folder,name)
    if not folder then
        return nil
    end

    local Obj = folder:FindFirstChild(name)

    if not Obj then
        Obj = Instance.new("Animation")
        Obj.Name = name
        Obj.Parent = folder
    end

    return Obj
end

local function applyFolder(animate,folderName,id,names)
    if not id then
        return
    end

    local Folder = animate:FindFirstChild(folderName)

    if not Folder then
        return
    end

    local Obj = findAnimation(Folder,table.unpack(names))

    if not Obj then
        Obj = makeAnimation(Folder,names[1])
    end

    setAnimation(Obj,id)
end

local function applyPack(name)

    local Pack = PACKS[name]

    if not Pack then
        return false
    end

    local Character = LP.Character

    if not Character then
        return false
    end

    local Animate = Character:FindFirstChild("Animate")

    if not Animate then
        return false
    end

    local Humanoid =
        Character:FindFirstChildOfClass("Humanoid")

    if Humanoid then
        for _,Track in ipairs(
            Humanoid:GetPlayingAnimationTracks()
        ) do
            pcall(function()
                Track:Stop(0)
            end)
        end
    end

    -- WALK
    applyFolder(
        Animate,
        "walk",
        Pack.Walk,
        {"WalkAnim","walk","RunAnim"}
    )

    -- RUN
    applyFolder(
        Animate,
        "run",
        Pack.Run,
        {"RunAnim","run","WalkAnim"}
    )

    -- JUMP
    applyFolder(
        Animate,
        "jump",
        Pack.Jump,
        {"JumpAnim","jump"}
    )

    -- FALL
    applyFolder(
        Animate,
        "fall",
        Pack.Fall,
        {"FallAnim","fall"}
    )

    -- CLIMB
    applyFolder(
        Animate,
        "climb",
        Pack.Climb,
        {"ClimbAnim","climb"}
    )

    -- SWIM
    applyFolder(
        Animate,
        "swim",
        Pack.Swim,
        {"Swim","SwimAnim","swim"}
    )

    -- SWIM IDLE
    applyFolder(
        Animate,
        "swimidle",
        Pack.SwimIdle,
        {"SwimIdle","SwimIdleAnim","swimidle"}
    )

    -- IDLE
    local IdleFolder = Animate:FindFirstChild("idle")

    if IdleFolder then

        local Idle1 =
            makeAnimation(
                IdleFolder,
                "Animation1"
            )

        local Idle2 =
            makeAnimation(
                IdleFolder,
                "Animation2"
            )

        if Pack.Idle1 then
            setAnimation(Idle1,Pack.Idle1)
        end

        if Pack.Idle2 then
            setAnimation(Idle2,Pack.Idle2)
        elseif Pack.Idle1 then
            setAnimation(Idle2,Pack.Idle1)
        end
    end

    -- RESTART ANIMATE
    pcall(function()
        Animate.Disabled = true
        task.wait(0.08)
        Animate.Disabled = false
    end)

    CurrentPack = name

    return true
end

