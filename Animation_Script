    L.BackgroundTransparency = 1 L.Text = txt L.TextColor3 = C.Wht L.Font = Enum.Font.GothamSemibold L.TextSize = 10 L.TextXAlignment = Enum.TextXAlignment.Left
    B.Size = UDim2.new(0.24,0,0.5,0) B.Position = UDim2.new(0.7,0,0.25,0) B.Font = Enum.Font.GothamBold B.TextSize = 9 Instance.new("UICorner", B).CornerRadius = UDim.new(0,5)
    local BS = Instance.new("UIStroke", B) BS.Thickness = 0.8
    
    allButtons[k] = {B = B, BS = BS}
    B.MouseButton1Click:Connect(function()
        if _G.Config[k] then return end
        local ok = applyPack(k)
        if ok then updateButtons(k) end
    end)
end

